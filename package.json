{
  "name": "pi-lazydocker",
  "version": "0.1.0",
  "description": "Open lazydocker inside Pi as a themed floating overlay or in fullscreen, with one keystroke (alt+l).",
  "license": "MIT",
  "type": "module",
  "author": "Asdrubal Hernandez (https://github.com/ahernand53)",
  "homepage": "https://github.com/ahernand53/pi-lazydocker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahernand53/pi-lazydocker.git"
  },
  "bugs": {
    "url": "https://github.com/ahernand53/pi-lazydocker/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "gentle-shell",
    "lazydocker",
    "docker",
    "docker-compose",
    "tui",
    "overlay"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/headless": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
